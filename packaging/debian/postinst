#!/bin/sh
set -e

FIRMWARE="@FIRMWARE_FILES@"

if [ "$1" = "configure" ] && [ -n "$FIRMWARE" ]; then
	found=""
	for f in $FIRMWARE; do
		# The kernel loader accepts a compressed copy where it was
		# built with CONFIG_FW_LOADER_COMPRESS, which Debian enables.
		for c in "" .xz .zst; do
			if [ -f "/lib/firmware/$f$c" ]; then
				found=yes
				break
			fi
		done
		[ -z "$found" ] || break
	done
	if [ -z "$found" ]; then
		echo "@PACKAGE@: no usable firmware found in /lib/firmware." >&2
		echo "@PACKAGE@: this package does not ship firmware." >&2
		echo "@PACKAGE@: the tuner will not create /dev/dvb without one of:" >&2
		for f in $FIRMWARE; do
			echo "@PACKAGE@:   $f" >&2
		done
		echo "@PACKAGE@: see /usr/share/doc/@PACKAGE@/README.Debian" >&2
	fi
fi

#DEBHELPER#

exit 0
